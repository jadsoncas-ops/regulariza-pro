generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id           String   @id @default(cuid())
  nomeFantasia String
  razaoSocial  String?
  cnpj         String?
  email        String?
  telefone     String?
  endereco     String?
  cidade       String?
  estado       String?
  crea         String?
  logoUrl      String?
  
  // Relations
  users        User[]
  clientes     Cliente[]
  imoveis      Imovel[]
  processos    Processo[]
  financeiro   Financeiro[]
  tarefas      Tarefa[]
  documentos   Documento[]
  logs         Log[]
  alertas      Alerta[]
  taskTemplates TaskTemplate[]
  stageHistory  StageHistory[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("operator")
  status    String   @default("ativo")
  
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])
  
  tarefasAtribuidas Tarefa[] @relation("AssignedTasks")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cliente {
  id          String       @id @default(cuid())
  nome        String
  cpf_cnpj    String
  rg_ie       String?
  telefone    String?
  email       String?
  endereco    String?
  numero      String?
  bairro      String?
  cidade      String?
  estado      String?
  cep         String?
  status      String       @default("ativo")
  observacoes String?
  password    String?
  accessCode  String?
  
  empresaId   String?
  empresa     Empresa?     @relation(fields: [empresaId], references: [id])
  
  processos   Processo[]
  imoveis     Imovel[]
  financeiro  Financeiro[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Imovel {
  id                    String      @id @default(cuid())
  clienteId             String
  cliente               Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  
  empresaId             String?
  empresa               Empresa?    @relation(fields: [empresaId], references: [id])
  
  endereco              String
  numero                String?
  complemento           String?
  tipo                  String?
  bairro                String?
  cidade                String?
  estado                String?
  cep                   String?
  area_terreno          Float?
  area_construida       Float?
  num_matricula         String?
  cartorio              String?
  inscricao_imobiliaria String?
  zoneamento            String?
  latitude              Float?
  longitude             Float?
  observacoes           String?
  proprietario_nome     String?
  proprietario_doc      String?
  proprietario_tel      String?
  proprietario_email    String?
  
  processos             Processo[]
  documentos            Documento[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model Processo {
  id                 String       @id @default(cuid())
  codigo_projeto     String?      @unique
  clienteId          String
  cliente            Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  imovelId           String?
  imovel             Imovel?      @relation(fields: [imovelId], references: [id])
  
  empresaId          String?
  empresa            Empresa?     @relation(fields: [empresaId], references: [id])
  
  tipo_regularizacao String
  etapa_atual        String?
  status             String       @default("em_analise")
  tags               String?      @default("[]")
  data_inicio        DateTime     @default(now())
  data_previsao      DateTime?
  responsavel        String?
  observacoes        String?
  valor_total        Float?
  valor_pago         Float?       @default(0)
  prioridade         String       @default("normal")
  data_deadline      DateTime?
  categoria          String?
  
  financeiro         Financeiro[]
  tarefas            Tarefa[]
  documentos         Documento[]
  checklists         Checklist[]
  eventos            Evento[]
  protocolos         Protocolo[]
  logs               Log[]
  stageHistory       StageHistory[]
  
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model StageHistory {
  id         String   @id @default(cuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  
  empresaId  String?
  empresa    Empresa? @relation(fields: [empresaId], references: [id])
  
  etapa      String
  entrada    DateTime @default(now())
  saida      DateTime?
  duracao    Int?     // Duração em minutos
  
  createdAt  DateTime @default(now())
}

model Financeiro {
  id              String    @id @default(cuid())
  processoId      String?
  processo        Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
  clienteId       String?
  cliente         Cliente?  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  
  empresaId       String?
  empresa         Empresa?  @relation(fields: [empresaId], references: [id])
  
  descricao       String
  categoria       String?
  valor           Float
  valor_pago      Float     @default(0)
  tipo            String    @default("receita")
  is_repasse      Boolean   @default(false)
  data_vencimento DateTime?
  data_pagamento  DateTime?
  forma_pagamento String?
  status          String    @default("pendente")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Tarefa {
  id          String    @id @default(cuid())
  titulo      String
  descricao   String?
  processoId  String?
  processo    Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
  
  empresaId   String?
  empresa     Empresa?  @relation(fields: [empresaId], references: [id])
  
  data        DateTime
  hora        String?
  responsavel String? // Legado
  
  assignedId  String?
  assignedTo  User?     @relation("AssignedTasks", fields: [assignedId], references: [id])
  
  prioridade  String    @default("normal")
  status      String    @default("pendente") // pending, in_progress, completed
  
  obrigatoria Boolean   @default(false)
  etapa       String?   // Etapa em que a tarefa foi criada
  
  startedAt   DateTime? // Quando mudou para 'in_progress'
  finishedAt  DateTime? // Quando mudou para 'completed'
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TaskTemplate {
  id          String    @id @default(cuid())
  etapa       String
  titulo      String
  descricao   String?
  prioridade  String    @default("normal")
  
  prazo_dias  Int       @default(3)
  obrigatoria Boolean   @default(true)
  papel_responsavel String?
  
  empresaId   String?
  empresa     Empresa?  @relation(fields: [empresaId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Protocolo {
  id               String    @id @default(cuid())
  processoId       String
  processo         Processo  @relation(fields: [processoId], references: [id], onDelete: Cascade)
  orgao            String
  numero_protocolo String
  data             DateTime
  prazo            DateTime?
  status           String    @default("em_analise")
  exigencia        String?
  observacao       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Log {
  id         String    @id @default(cuid())
  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
  
  empresaId  String?
  empresa    Empresa?  @relation(fields: [empresaId], references: [id])
  
  usuario    String
  acao       String
  modulo     String
  detalhe    String?
  createdAt  DateTime  @default(now())
}

model Documento {
  id          String    @id @default(cuid())
  processoId  String?
  processo    Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
  imovelId    String?
  imovel      Imovel?   @relation(fields: [imovelId], references: [id])
  
  empresaId   String?
  empresa     Empresa?  @relation(fields: [empresaId], references: [id])
  
  nome        String
  tipo        String
  url         String
  tamanho     Int?
  status      String    @default("pendente")
  categoria   String?
  responsavel String?
  observacoes String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Checklist {
  id          String   @id @default(cuid())
  processoId  String
  processo    Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  item        String
  concluido   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Evento {
  id          String    @id @default(cuid())
  titulo      String
  descricao   String?
  tipo        String    @default("reuniao")
  processoId  String?
  processo    Processo? @relation(fields: [processoId], references: [id])
  data_inicio DateTime
  data_fim    DateTime?
  local       String?
  responsavel String?
  status      String    @default("agendado")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime @updatedAt
}

model Alerta {
  id          String   @id @default(cuid())
  titulo      String
  mensagem    String
  tipo        String   @default("info")
  lido        Boolean  @default(false)
  processoId  String?
  clienteId   String?
  
  empresaId   String?
  empresa     Empresa? @relation(fields: [empresaId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServicoPadrao {
  id          String   @id @default(cuid())
  nome        String   @unique
  sigla       String
  categoria   String
  descricao   String?
  subservicos String[]
  createdAt   DateTime @default(now())
}
