generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cliente {
  id          String       @id @default(cuid())
  nome        String
  cpf_cnpj    String
  telefone    String?
  email       String?
  endereco    String?
  numero      String?
  bairro      String?
  cidade      String?
  estado      String?
  cep         String?
  status      String       @default("ativo")
  observacoes String?
  processos   Processo[]
  imoveis     Imovel[]
  financeiro  Financeiro[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Imovel {
  id                    String      @id @default(cuid())
  clienteId             String
  cliente               Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  endereco              String
  numero                String?
  complemento           String?
  tipo                  String?     // Residencial, Comercial, Não Informado...
  bairro                String?
  cidade                String?
  estado                String?
  cep                   String?
  area_terreno          Float?
  area_construida       Float?
  num_matricula         String?
  cartorio              String?
  inscricao_imobiliaria String?
  zoneamento            String?
  latitude              Float?
  longitude             Float?
  observacoes           String?
  proprietario_nome     String?
  proprietario_doc      String?
  proprietario_tel      String?
  proprietario_email    String?
  processos             Processo[]
  documentos            Documento[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model Processo {
  id                 String       @id @default(cuid())
  codigo_projeto     String?      @unique
  clienteId          String
  cliente            Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  imovelId           String
  imovel             Imovel       @relation(fields: [imovelId], references: [id])
  tipo_regularizacao String
  etapa_atual        String?
  status             String       @default("em_analise")
  tags               String?      @default("[]") // JSON array de tags ex: ["#habite-se","#prefeitura"]
  data_inicio        DateTime     @default(now())
  data_previsao      DateTime?
  responsavel        String?
  observacoes        String?
  valor_total        Float?
  valor_pago         Float?       @default(0)
  prioridade         String       @default("normal")
  data_deadline      DateTime?
  categoria          String?
  financeiro         Financeiro[]
  tarefas            Tarefa[]
  documentos         Documento[]
  checklists         Checklist[]
  eventos            Evento[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Financeiro {
  id              String    @id @default(cuid())
  processoId      String?
  processo        Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
  clienteId       String?
  cliente         Cliente?  @relation(fields: [clienteId], references: [id])
  descricao       String
  categoria       String?   // ex: Elaboração de Projeto, Comissão...
  valor           Float
  valor_pago      Float     @default(0)
  tipo            String    @default("receita") // receita, despesa
  is_repasse      Boolean   @default(false)
  data_vencimento DateTime?
  data_pagamento  DateTime?
  forma_pagamento String?
  status          String    @default("pendente")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Tarefa {
  id          String    @id @default(cuid())
  titulo      String
  descricao   String?
  processoId  String?
  processo    Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
  data        DateTime
  hora        String?
  responsavel String?
  status      String    @default("pendente")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Documento {
  id          String    @id @default(cuid())
  processoId  String?
  processo    Processo? @relation(fields: [processoId], references: [id], onDelete: Cascade)
  imovelId    String?
  imovel      Imovel?   @relation(fields: [imovelId], references: [id])
  nome        String
  tipo        String
  url         String
  tamanho     Int?
  status      String    @default("pendente") // pendente, verificado, recusado
  categoria   String?   // certidoes, art, projeto, alvara, habite_se
  responsavel String?
  observacoes String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Checklist {
  id          String   @id @default(cuid())
  processoId  String
  processo    Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  item        String
  concluido   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Evento {
  id          String    @id @default(cuid())
  titulo      String
  descricao   String?
  tipo        String    @default("reuniao")
  processoId  String?
  processo    Processo? @relation(fields: [processoId], references: [id])
  data_inicio DateTime
  data_fim    DateTime?
  local       String?
  responsavel String?
  status      String    @default("agendado")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Alerta {
  id          String   @id @default(cuid())
  titulo      String
  mensagem    String
  tipo        String   @default("info")
  lido        Boolean  @default(false)
  processoId  String?
  clienteId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmpresaConfig {
  id           String   @id @default(cuid())
  nomeFantasia String
  razaoSocial  String?
  cnpj         String?
  email        String?
  telefone     String?
  endereco     String?
  cidade       String?
  estado       String?
  crea         String?
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ServicoPadrao {
  id          String   @id @default(cuid())
  nome        String   @unique
  sigla       String
  categoria   String
  descricao   String?
  subservicos String[]
  createdAt   DateTime @default(now())
}
